# FC Webhook Service — environment variables
# Copy to .env and fill in your values.

# GitHub webhook HMAC secret (set in GitHub org/repo webhook settings)
GITHUB_WEBHOOK_SECRET=whsec_your_secret_here

# Shared API key between FC and Dispatcher
# Generate: python -c "import secrets; print(secrets.token_hex(16))"
API_KEY=change_me_to_a_random_32_char_string

# SQLite database path
# Cloud (NAS mount):  /mnt/nas/events.db
# Local development:  ./data/events.db
DB_PATH=./data/events.db

# Optional — comma-separated repo filter (empty = allow all)
ALLOWED_REPOS=

# Optional — comma-separated event type filter (empty = allow all)
ALLOWED_EVENTS=

# Claim TTL in minutes (stale processing events are requeued)
CLAIM_TTL_MINUTES=15

# Max retries before marking failed
MAX_RETRIES=3

LOG_LEVEL=INFO
